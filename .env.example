# Never commit a real API key.
OPENAI_API_KEY=your_openai_api_key_here

# Cost-sensitive default for subtitle translation.
OPENAI_MODEL=gpt-5.6-luna

# Optional shared token for local/private testing.
DUALSUB_ACCESS_TOKEN=

# Optional comma-separated browser origins.
ALLOWED_ORIGINS=

PORT=8787
HOST=127.0.0.1
